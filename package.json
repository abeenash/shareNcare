{
  "name": "sharencare",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun run --filter @sharencare/api dev",
    "dev:web": "bun run --filter @sharencare/web dev",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript": "^7.0.2"
  }
}