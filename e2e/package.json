{
  "name": "@sharencare/e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "db:up": "docker run --rm -d --name sharencare-e2e-db -e POSTGRES_PASSWORD=postgres -p 5433:5432 postgres:18-alpine",
    "db:down": "docker stop sharencare-e2e-db",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24"
  }
}
