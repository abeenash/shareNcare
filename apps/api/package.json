{
  "name": "@sharencare/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/types.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run db:migrate && bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate",
    "db:studio": "bun --bun drizzle-kit studio"
  },
  "dependencies": {
    "@hono/bun": "^1.0.1",
    "@hono/zod-validator": "^0.9.1",
    "@sharencare/shared": "workspace:*",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.40.0",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/bun": "^1.4.4",
    "drizzle-kit": "^0.31.11"
  }
}
